<?xml version="1.0" encoding="utf-8"?>
<!--
  디버그 빌드 전용 네트워크 정책.

  안드로이드는 targetSdk 28 부터 평문 HTTP 를 기본 차단한다. 로컬 API 서버를
  붙여 확인하려면 예외가 필요하지만, 그 예외가 릴리스에 새어 나가면 실사용자
  트래픽이 평문으로 나갈 수 있다. 그래서 src/debug 에만 둔다 —
  src/main 이나 src/release 로 옮기지 말 것.

  허용 대상은 개발 호스트뿐이다:
    10.0.2.2  안드로이드 에뮬레이터에서 본 호스트 PC
    localhost 실기기 adb reverse 로 포워딩한 경우
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
