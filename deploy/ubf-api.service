# UBF 등록 API (Node)
#
# 설치: /etc/systemd/system/ubf-api.service
# 환경: /srv/ubf/api/.env  (DATABASE_URL / JWT_SECRET / ALLOWED_ORIGINS)
#
# 이 서버에는 다른 서비스가 여럿 돌고 있다. 포트 3100 은 사용 중이 아님을
# 확인하고 골랐다(3000·3100·3200 모두 비어 있었다).

[Unit]
Description=UBF conference registration API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/ubf/api
EnvironmentFile=/srv/ubf/api/.env

# NODE_ENV 는 여기서 못박는다. 빠지면 서버가 dev-login 을 열 수 있는 상태가
# 되므로(현재는 ENABLE_DEV_LOGIN 이 따로 필요하지만) 이중으로 잠근다.
Environment=NODE_ENV=production
Environment=PORT=3100

ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3

# 설정이 잘못돼 기동에 실패하면 무한 재시작으로 로그만 쌓인다.
# 5분 안에 5회 실패하면 멈추고 상태를 남긴다.
StartLimitIntervalSec=300
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ubf-api

# ── 격리 ──────────────────────────────────────────────────────
# 같은 호스트에 다른 서비스가 많으므로 이 프로세스가 접근할 수 있는 범위를 줄인다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ubf/api
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
